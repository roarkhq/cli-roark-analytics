#!/usr/bin/env bash
set -exuo pipefail

rm -rf dist

# `src/version.ts` is not rewritten by release-please, so it is the one thing
# that can silently disagree with package.json. Sync before compiling.
node scripts/sync-version.cjs

# Plain tsc: this package is a bin, not a library, so it needs neither the dual
# CJS/ESM output nor the export-map rewriting the SDK and MCP server go through.
./node_modules/.bin/tsc -p tsconfig.build.json

chmod +x dist/bin.js

# The package is published from dist/, the same as the SDK and the MCP server, so
# everything the tarball needs has to be copied in. `man` paths in package.json
# are already dist-relative; make-dist-package-json rewrites the `bin` path.
cp -rp README.md man dist
for file in LICENSE CHANGELOG.md; do
  if [ -e "${file}" ]; then cp "${file}" dist; fi
done

node scripts/make-dist-package-json.cjs > dist/package.json

# Ship a lockfile, so that installing a given CLI version resolves the same
# dependency tree today and in six months. Without one, `commander@^14.0.3` and
# friends are re-resolved on every install, and the only thing checked against a
# published hash is the entry package.
#
# It has to be `npm-shrinkwrap.json` and not `package-lock.json`: npm never
# publishes the latter - it is on npm-packlist's permanent exclude list - so a
# package-lock generated here would be silently dropped from the tarball and the
# problem would look solved without being solved.
#
# This is the one build step that needs the network, and it is deliberately not
# allowed to fail the build. `package.json` declares a range on a *published*
# `@roarkanalytics/sdk`, and the moment that range is bumped ahead of the SDK's
# own release - which is the normal order, since the CLI is regenerated from the
# same spec change that produces the SDK - the resolve here cannot succeed.
# Failing the build then would make every commit in that window red for a reason
# that has nothing to do with the commit.
#
# So: warn and carry on. The shrinkwrap is a property of a *published* artifact,
# and publish.yml is where its absence is fatal - it refuses to publish a tarball
# without one, after first checking the SDK version is on npm, so the publish
# path still cannot skip it silently.
(
  cd dist

  if npm install --package-lock-only --omit=dev --ignore-scripts --no-audit --no-fund --loglevel=error; then
    # Renames package-lock.json to npm-shrinkwrap.json, which is the whole point:
    # npm never publishes a package-lock.
    npm shrinkwrap --loglevel=error
  else
    sdk_range=$(node -p "require('./package.json').dependencies['@roarkanalytics/sdk']")
    # A failed resolve can still leave a partial lockfile behind, and a
    # package-lock in dist/ is worse than nothing: it is not published, so it
    # would sit there looking like the shrinkwrap that is not there.
    rm -f package-lock.json
    echo "warning: could not resolve the dependency tree, so this build has no shrinkwrap." >&2
    echo "         The usual cause is that @roarkanalytics/sdk@${sdk_range} is not on npm yet;" >&2
    echo "         the SDK publishes on its own release train and the CLI builds against it." >&2
    echo "         Harmless for a local or CI build. publish-cli.yml refuses to publish" >&2
    echo "         without one, so a release cannot pick this up by accident." >&2
  fi
)
